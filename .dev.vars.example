# Copy this file to `.dev.vars` (gitignored) for local development.
# `wrangler dev` reads it automatically. NEVER COMMIT `.dev.vars`.
#
# Confirmed Urban Cowboy Lodge Catskills production identifiers.
MEWS_BASE_URL=https://api.mews.com
MEWS_APP_BASE_URL=https://app.mews.com

# Booking Engine API client string registered with Mews.
MEWS_CLIENT=<Client string provided/registered with Mews — DO NOT commit the real value>

MEWS_HOTEL_ID=8bd38131-c371-4625-9c29-b10600705d34
MEWS_CONFIG_ID=4725ace3-6b93-439f-a549-b4bc00ae1d10
MEWS_ADULT_AGE_CATEGORY_ID=8f3ceb39-5c40-417a-b9a5-b106007064f8
MEWS_CHILD_AGE_CATEGORY_ID=db093f0b-738e-4afe-9191-b106007065ff

# Webflow CMS is fetched by the Worker only. Never expose the API token through
# a VITE_* variable or return it to browser code.
WEBFLOW_SITE_ID=6aaa2497c8ea366207beba30
WEBFLOW_RATE_CARD_COLLECTION_ID=6abc811cb92ea32dd64d79e0
WEBFLOW_ROOM_TYPE_COLLECTION_ID=6abc815b36cbcba74b8b01c4
WEBFLOW_ADD_ON_COLLECTION_ID=6ac364287c8782e8e653075e
WEBFLOW_CMS_API_TOKEN=<Webflow CMS API token — DO NOT commit the real value>

# Funnel tracking is disabled unless this project provisions its own endpoint.
# WEBHOOK_EVENTS=https://example.com/webhook/booking-events
