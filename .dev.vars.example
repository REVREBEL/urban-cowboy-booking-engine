# Copy this file to `.dev.vars` (gitignored) for local development.
# `wrangler dev` reads it automatically. NEVER COMMIT `.dev.vars`.
#
# Confirmed Urban Cowboy Lodge Catskills production identifiers.
MEWS_BASE_URL=https://api.mews.com
MEWS_APP_BASE_URL=https://app.mews.com

# Booking Engine API client string registered with Mews.
MEWS_CLIENT="REVREBEL Urban Cowboy Booking Engine 1.0.0"

MEWS_HOTEL_ID=8bd38131-c371-4625-9c29-b10600705d34
MEWS_CONFIG_ID=4725ace3-6b93-439f-a549-b4bc00ae1d10
MEWS_ADULT_AGE_CATEGORY_ID=8f3ceb39-5c40-417a-b9a5-b106007064f8
MEWS_CHILD_AGE_CATEGORY_ID=db093f0b-738e-4afe-9191-b106007065ff

# Webflow CMS is fetched by the Worker only. Never expose the API token through
# a VITE_* variable or return it to browser code.
WEBFLOW_SITE_ID=6aaa2497c8ea366207beba30
WEBFLOW_RATE_CARD_COLLECTION_ID=6abc811cb92ea32dd64d79e0
WEBFLOW_CONTENT_SETTINGS_COLLECTION_ID=6ae9007b42ce65b87edf2606
WEBFLOW_POLICY_LANGUAGE_ITEM_ID=6ae90585b3980e103b55a468
WEBFLOW_ROOM_TYPE_COLLECTION_ID=6abc815b36cbcba74b8b01c4
WEBFLOW_AMENITY_COLLECTION_ID=6abc8175a7bbdc92fa9e6599
WEBFLOW_PHOTO_HOTSPOT_COLLECTION_ID=6acfb8250c28159487fb2aaf
WEBFLOW_ADD_ON_COLLECTION_ID=6ac364287c8782e8e653075e
WEBFLOW_LOCATION_ITEM_ID=6abc9142d98b325b2821ca23
# Required for the Webflow baseline. Set the real 24-character Locations
# collection ID before deploying; the deploy script rejects placeholders.
WEBFLOW_LOCATION_COLLECTION_ID=__SET_WEBFLOW_LOCATION_COLLECTION_ID__
WEBFLOW_CMS_API_TOKEN=<Webflow CMS API token — DO NOT commit the real value>

# Funnel tracking is disabled unless this project provisions its own endpoint.
# WEBHOOK_EVENTS=https://example.com/webhook/booking-events

# Cloudflare Access protects the private /api/recovery and
# /api/analytics/summary routes. Set these only for a real Access application;
# without them the Worker fails closed and returns 401.
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=<Access application AUD UUID>
# ADMIN_EMAILS=admin@example.com,ops@example.com
# ADMIN_GROUPS=<IdP group UUID allowed the admin role>
# TENANT_ID=urban-cowboy

# CMS read migration (COW-39). The production baseline must set every source
# explicitly to webflow. A D1 cutover is a separate reviewed deployment using the
# Gate 2 runbook; deploy-worker.mjs refuses non-webflow baseline flags.
CONTENT_SOURCE=webflow
CONTENT_SOURCE_POLICY_LANGUAGE=webflow
CONTENT_SOURCE_SITE_SETTINGS=webflow
CONTENT_SOURCE_ADD_ONS=webflow
CONTENT_SOURCE_ROOM_GALLERIES=webflow

# COW-82 guest hotspot cutover. webflow (default) keeps the existing source;
# d1 serves only published, approved, non-deleted hotspots from D1.
PHOTO_HOTSPOT_SOURCE=webflow

# --- COW-114 local admin preview against the seeded local D1 ---
# Local-only overrides. Later definitions win when this file is copied to
# .dev.vars, so the webflow baseline above stays intact for deployments (the
# deploy renderer reads .env, never this file).
LOCAL_DEV_PREVIEW=1
TENANT_ID=urban-cowboy
CONTENT_SOURCE=d1
CONTENT_SOURCE_POLICY_LANGUAGE=d1
CONTENT_SOURCE_SITE_SETTINGS=d1
CONTENT_SOURCE_ADD_ONS=d1
CONTENT_SOURCE_ROOM_GALLERIES=d1
PHOTO_HOTSPOT_SOURCE=d1
