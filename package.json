{
  "name": "urban-cowboy-booking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Urban Cowboy (Mews Booking Engine API) — Cloudflare Workers + Static Assets",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently -k -n worker,web -c magenta,cyan \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "VITE_SHOW_API_DEBUGGER=true vite build && wrangler dev --port 8787 --ip 127.0.0.1",
    "dev:web": "vite",
    "components": "vite --open /components.html",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8787 --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "room-ids": "node scripts/fetch-room-category-ids.mjs",
    "normalize:svgs": "node scripts/normalize-svg-assets.mjs --write",
    "normalize:svgs:check": "node scripts/normalize-svg-assets.mjs",
    "mews:smoke": "bash scripts/test-mews-booking-api.sh",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:clean": "node scripts/build-icons.mjs --clean",
    "sync:room-photos": "node scripts/sync-mews-room-photos.mjs",
    "tokens:audit": "node scripts/tokenize-design-system.mjs",
    "tokens:fix": "node scripts/tokenize-design-system.mjs --write",
    "tokens:check": "node scripts/tokenize-design-system.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-aspect-ratio": "^1.1.16",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-menubar": "^1.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/upgrade": "^4.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.54.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.3",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "detect-port": "^2.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "tree-sitter@0.22.4": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-typescript@0.23.2": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
