);
CREATE TABLE saved_room_matches (
  id TEXT PRIMARY KEY,
  session_id TEXT NOT NULL,
  room_category_id TEXT NOT NULL,
  check_in TEXT,
  check_out TEXT,
  adults INTEGER,
  children INTEGER,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  FOREIGN KEY (session_id) REFERENCES guest_sessions (id)
);
CREATE TABLE cart_abandonments (
  id TEXT PRIMARY KEY,
  session_id TEXT NOT NULL,
  reservation_id TEXT,
  status TEXT NOT NULL DEFAULT 'open',
  recovered_value REAL,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at TEXT NOT NULL DEFAULT (datetime('now')),
  FOREIGN KEY (session_id) REFERENCES guest_sessions (id)
);
CREATE TABLE recovery_campaigns (
  id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
  template_key TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'draft',
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  FOREIGN KEY (tenant_id) REFERENCES tenants (id)
);
CREATE TABLE analytics_events (
  id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
  location_id TEXT,
  session_id TEXT,
  event_type TEXT NOT NULL,
  payload_json TEXT,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  FOREIGN KEY (tenant_id) REFERENCES tenants (id)
);
CREATE TABLE analytics_daily (
  id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
  location_id TEXT,
  day TEXT NOT NULL,
  metric TEXT NOT NULL,
  value REAL NOT NULL DEFAULT 0,
  UNIQUE (tenant_id, location_id, day, metric),
  FOREIGN KEY (tenant_id) REFERENCES tenants (id)
);
CREATE TABLE room_types (
  id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
