INSERT INTO add_ons VALUES('6ac364b4461ca2eb8f33eeb5','urban-cowboy',NULL,'Eat Hummus','Pendleton robe on. Catskills outside. Snacks handled. House-made hummus served with a colorful selection of our favorite local, seasonal vegetables.','d4e2bfdd-f01f-4177-b366-b12401712a25',NULL,999,8,'published','2026-11-17 16:06:35','2026-11-17 16:06:35');
INSERT INTO add_ons VALUES('6ac3646a2435ff11b5014e5f','urban-cowboy',NULL,'Dog Inclusion','Bring the dog. We love meeting them. A $50 per dog, per night cleaning fee applies. Dogs only, please. If you forgot potty bags, food, or treats, swing by the Front Desk. Chances are the team was already hoping to meet your pup anyway.','c74edf03-043c-4217-adbd-b124016a55ae',NULL,2,4,'published','2026-11-17 16:06:35','2026-11-17 16:06:35');
