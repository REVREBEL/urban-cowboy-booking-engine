INSERT INTO published_snapshots VALUES('urban-cowboy','','addOns','44ee2984f16fdb15c8c634c766b80d97e899ee37a252e899c7ca99fc9f350922','{"collection":"addOns","version":"44ee2984f16fdb15c8c634c766b80d97e899ee37a252e899c7ca99fc9f350922","itemCount":9,"items":[{"id":"6ac3646a2435ff11b5014e5f","collection":"addOns","payload":{"locationId":null,"name":"Dog Inclusion","description":"Bring the dog. We love meeting them. A $50 per dog, per night cleaning fee applies. Dogs only, please. If you forgot potty bags, food, or treats, swing by the Front Desk. Chances are the team was already hoping to meet your pup anyway.","mewsProductId":"c74edf03-043c-4217-adbd-b124016a55ae","quantityCap":2,"sortOrder":4,"status":"published"}},{"id":"6ac364b4461ca2eb8f33eeb5","collection":"addOns","payload":{"locationId":null,"name":"Eat Hummus","description":"Pendleton robe on. Catskills outside. Snacks handled. House-made hummus served with a colorful selection of our favorite local, seasonal vegetables.","mewsProductId":"d4e2bfdd-f01f-4177-b366-b12401712a25","quantityCap":999,"sortOrder":8,"status":"published"}},{"id":"6ac3654226a0b23fca4b8e6d","collection":"addOns","payload":{"locationId":null,"name":"Smores Kit","description":"Meet at the fire. Everything you need for a proper Cowboy s’more, packed and ready for the fire. Graham crackers, marshmallows, chocolate, and skewers included. All that’s missing is a little smoke in your hair.","mewsProductId":"cad13cb9-752d-49e8-b5d3-b124016d3aa8","quantityCap":999,"sortOrder":9,"status":"published"}},{"id":"6ac3655da17f672b4dd9a313","collection":"addOns","payload":{"locationId":null,"name":"Bathing Ritual Kit","description":"Make the tub part of the plan. Your bathing ritual kit includes a few simple things to slow things down, like bath soak, a face mask, herbal tea, and a little something for afterward. Run the water. Put the robe on. The rest can wait.","mewsProductId":"cad13cb9-752d-49e8-b5d3-b124016d3aa8","quantityCap":2,"sortOrder":6,"status":"published"}},{"id":"6ac3657002f7d9d8f917db42","collection":"addOns","payload":{"locationId":null,"name":"Celebration Cake","description":"Mark a birthday, anniversary, or just a very good reason to get away with something sweet waiting in your room. We’ll have a celebration cake ready for your arrival, sourced from one of our favorite local bakers.","mewsProductId":"cad13cb9-752d-49e8-b5d3-b124016d3aa8","quantityCap":1,"sortOrder":7,"status":"published"}},{"id":"6ac3658035f8231d963596d4","collection":"addOns","payload":{"locationId":null,"name":"Fresh Cut Flowers","description":"Bring a little of the Catskills inside. We’ll have a fresh bouquet waiting in your room when you arrive.","mewsProductId":"d8009b60-0580-49e7-a5dd-b12401713848","quantityCap":2,"sortOrder":3,"status":"published"}},{"id":"6ac3659626a0b23fca4ba4cc","collection":"addOns","payload":{"locationId":null,"name":"Alice Mushroom Chocolate","description":"Whether you need to refocus your morning with a burst of brain energy, or need to calm your mind at the end of a long day, Alice Mushroom Chocolate has the answer for you.","mewsProductId":"cad13cb9-752d-49e8-b5d3-b124016d3aa8","quantityCap":4,"sortOrder":5,"status":"published"}},{"id":"6ac365a92ae5321987129541","collection":"addOns","payload":{"locationId":null,"name":"Let''s Drink Wine","description":"Start your stay the Cowboy way, with a bottle waiting in your room when you arrive.\nChoose from Red, White, Sparkling, Orange, or Rosé, and we’ll select one of our favorites for you.","mewsProductId":"cad13cb9-752d-49e8-b5d3-b124016d3aa8","quantityCap":999,"sortOrder":2,"status":"published"}},{"id":"6ac372620a9fc691657ebf1e","collection":"addOns","payload":{"locationId":null,"name":"Chocolate Truffles","description":"A little taste of the Catskills waiting in your room. Six handpicked assorted chocolate truffles, perfect for arrival, after dinner, or whenever the mood strikes.","mewsProductId":"41f8b399-a303-40ac-bbfc-b124016e6b85","quantityCap":2,"sortOrder":1,"status":"published"}}]}',9,'44ee2984f16fdb15c8c634c766b80d97e899ee37a252e899c7ca99fc9f350922','2026-11-24 08:07:48');
