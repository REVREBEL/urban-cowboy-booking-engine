INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312dc','urban-cowboy','Walden Bathing Suite Den','Extra indoor lounging space paired with Walden''s outdoor bathing ritual.','The alcove gives the Walden Forest Bathing Suite more room to live in, not just sleep in. Settle into the lounge before stepping onto the private deck and into the cedar tub under the trees.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312da','urban-cowboy','Walden Den Alcove','A built-in chaise alcove for reading, lounging and watching the woods from inside.','The Den''s built-in alcove gives Walden an extra place to disappear between soaks. Stretch out with a book, watch the light change through the trees or stay exactly where you are until dinner becomes somebody else''s problem.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312d8','urban-cowboy','Walden Private Balcony','A private Walden deck tucked into the trees on the creekside side of the property.','Step outside your Walden room and the forest gets immediately closer. The private deck gives you a quiet place for coffee, a nightcap or the long stretch between plans when the creek and trees are enough.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312d6','urban-cowboy','Mountain Views','Big Catskills views with very little effort required on your part.','Windows, balconies and porches frame the mountains differently across the property. The common thread is simple: look up, slow down and let the valley, peaks and weather keep changing the picture.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312d4','urban-cowboy','Slide Mountain Haus Living Room','Shared living space for the crew when you take over Slide Mountain Haus.','When the whole Haus is yours, the living room becomes the place everyone eventually lands. Gather before the trail, recover after it or let the group scatter across the house and find its way back here.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312d2','urban-cowboy','Slide Mountain Downstairs Living Room','A proper living room for game nights, slow mornings and your first-floor Slide Mountain home base.','The downstairs living room gives the two-bedroom Slide Mountain setup a shared center of gravity, with room to spread out before the trail, after Ralph''s or during the highly underrated middle part of the day.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312d0','urban-cowboy','Sitting Area','A little more room to sit somewhere that is not the bed.','A dedicated sitting area gives you a place for coffee, reading, conversation or staring out the window while pretending that counts as an activity. Around here, it does.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312ce','urban-cowboy','Separate Living Room','A bedroom that does not have to do all the work.','A separate living room gives the stay another place to happen. Spread out, gather with your people or close the bedroom door and keep the conversation going somewhere else.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312cc','urban-cowboy','Private Wet Bar','Your own wet bar for keeping the evening close to home.','A private wet bar gives the living space a little more independence. Pour a drink, make something cold and stay upstairs when the room is exactly where you want to be.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312c8','urban-cowboy','Outdoor Patio or Balcony with Chairs','A simple outdoor perch for fresh air without leaving your room behind.','A simple outdoor perch for fresh air without leaving your room behind. Take breakfast outside, linger after a soak or sit still long enough to notice how quiet the mountain gets.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312c6','urban-cowboy','Outdoor Patio or Balcony with Chairs','A small outdoor setup for coffee, nightcaps and watching the woods do their thing.','A simple outdoor perch for fresh air without leaving your room behind. Take breakfast outside, linger after a soak or sit still long enough to notice how quiet the mountain gets.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312c4','urban-cowboy','Opa''s Full Kitchen','A proper kitchen and dining setup for doing the whole Upstate-house thing yourselves.','Opa''s gives the group a full kitchen and dining area, so breakfast, dinner and the snacks between them can happen on your own clock. Cook together, assign one brave volunteer or ignore the kitchen entirely.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312c2','urban-cowboy','Opa''s Cabin Living Room','A vaulted living room gathered around a big river-stone hearth.','Opa''s shared heart is downstairs: exposed wood beams overhead, the river-stone fireplace in front of you and enough room for the whole group to settle in without sitting on top of one another.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312c0','urban-cowboy','Marshall Speaker','A Marshall speaker for putting a soundtrack to the room.','Queue up the road-trip playlist, something slow for the bath or the record you forgot existed. The speaker is there when the room needs music and easy to ignore when the forest sounds better.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312bc','urban-cowboy','Kitchen with Breakfast Bar','A full kitchen with a casual perch for coffee, snacks and plans that may never happen.','Cook when you want to, then pull up to the breakfast bar for the informal part. It is useful space that makes a longer stay feel less like hotel living and more like having your own place Upstate.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312b8','urban-cowboy','Chalet Living Room','Room to spread out beneath the Chalet''s wood-paneled cathedral ceilings.','Two lounging areas, big windows and a fireplace give the Chalet real living space beyond the bedroom. It is made for long mornings, late drinks and the kind of afternoon that accidentally becomes evening.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312b6','urban-cowboy','Chalet Full Kitchen','A full kitchen for breakfast at noon, dinner at midnight or whatever happens in between.','The Chalet gives you a proper kitchen of your own, so the stay can feel more like borrowing a mountain house than checking into a hotel. Cook something ambitious, heat up something easy or leave it untouched and go to dinner.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312b4','urban-cowboy','Cabin Sitting Area','A private place to stretch out somewhere that is not the bed.','The Cabin''s sitting area gives the room a second rhythm: read by the fire, pour a drink, or do absolutely nothing from a proper seat before wandering back to the tub, porch or bed.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312b2','urban-cowboy','Cabin Bedroom','A king bedroom tucked inside your own standalone Catskills hideaway.','The Cabin bedroom keeps the mood warm and private, with the bed at the center and the rest of the standalone space just beyond it. Close the door, settle in and let the woods handle the view.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312ae','urban-cowboy','Single Bed','One straightforward bed for a room that keeps things simple.','A clean, uncomplicated sleeping setup for guests who need one bed and would rather let the rest of the Catskills provide the decoration. Cowboy rooms are outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control. What it means for your stay: A genuinely good bed waiting after the sauna, the trail, one more drink at Ralph''s, or absolutely nothing at all.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312ac','urban-cowboy','Single Bed with Headboard','One bed, one proper headboard outfitted with a Wright mattress and one very good excuse to sleep late.','A simple single-bed setup with a defined headboard and enough visual weight to make the bed feel like part of the room rather than something dropped into it. Cowboy rooms are outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control. What it means for your stay: A genuinely good bed waiting after the sauna, the trail, one more drink at Ralph''s, or absolutely nothing at all.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312aa','urban-cowboy','Lodge Penthouse King Bed','A king bed anchored by the Penthouse''s hand-crafted black-willow headboard.','At the top of the Lodge, the king bed gets a little theater from its hand-crafted black-willow headboard. It is part bed, part woodland sculpture, and exactly the sort of detail that makes the Penthouse feel unlike anywhere else in the building.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312a8','urban-cowboy','Two Beds without Headboards','Two straightforward beds for a simple, flexible sleeping setup.','No extra ceremony here. Two separate beds give friends or family an easy place to sleep while leaving the rest of the room open for the parts of the trip that happen while everyone is awake.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312a6','urban-cowboy','Two Beds with Headboards','Two separate beds, each with a proper headboard and room to land.','A flexible setup for friends or family, with two distinct beds that make sharing the room easy without asking anyone to surrender their own corner of it.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312a4','urban-cowboy','Bathroom Amenities','Thoughtful bath essentials for the soak, the shower and whatever comes after.','Everything you need to settle into the bathing ritual, from shower essentials to the small comforts waiting by the sink. Practical, considered and designed to keep the bathroom feeling like part of the stay, not a checklist.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b6312a0','urban-cowboy','Alpine Bear Pattern Bed','A king bed with a little wilderness worked right into the pattern.','The bear-patterned Alpine bed brings a playful dose of mountain character to the room while keeping the important part simple: a generous place to sleep. Outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b63129e','urban-cowboy','Built-In Alcove','A tucked-away nook made for reading, lounging and disappearing for a while.','A small room within the room. Settle into the alcove with a book, a drink or absolutely no plan, and let the rest of the suite carry on without you.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfadbc62dec1d97b63129c','urban-cowboy','Architectural Diamond Window','A diamond-shaped window that turns morning light and mountain weather into part of the room.','One of Cowboy''s unique architectural details: a diamond-shaped window framing treetops, sky and shifting Catskills light. It gives the room a view with a little more character than a standard rectangle.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfaa2ef94e6428a3ad2661','urban-cowboy','Lodge Penthouse Living Room','A substantial private living room at the top of the Lodge, made for lingering between whatever comes next.','The Penthouse gives you more than a bedroom. Its private living room brings together vaulted windows, comfortable seating, a wet bar and room to settle in, with the social heart of Cowboy just downstairs.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfa9e57c6104a6aa94c51e','urban-cowboy','Cabin King Bed + Bunk','A king bed with an extra bunk nook, outfitted with Wright mattresses, built for a little more flexibility inside your private cabin','The Cabin keeps the sleeping setup relaxed: a proper king bed anchors the room, while the built-in bunk or lounging nook gives you another place to stretch outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfa9a401e6d06e270bdcdf','urban-cowboy','Alpine King Bed','A king bed dressed in the bold Southwestern pattern that gives Alpine its unmistakable Cowboy character.','The bed is the visual center of the room: a Wright king mattress layered with Pendleton warmth and a Southwestern-patterned headboard treatment that brings a little graphic swagger to Alpine without getting in the way of a very good night''s sleep.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acfa9526e22d8f55d602032','urban-cowboy','Double Beds','Two proper beds for friends, family or anyone who sleeps better with a little territory of their own.','Two separate beds keep the room flexible for friends and families, with enough personal space to spread-out. Outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control. What it means for your stay: A genuinely good bed waiting after the sauna, the trail, one more drink at Ralph''s, or absolutely nothing at all.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6acb3c6dd423991cbf6a43ec','urban-cowboy','Family Friendly','Room to bring the little campers along.','These accommodations welcome families, with layouts that make it easier to stay together without giving up the breathing room that brought you to the mountains in the first place.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6ac3e0882889661b038ec787','urban-cowboy','Minibar','Good things within arm''s reach when leaving the room feels wildly unnecessary.','The in-room minibar keeps snacks and drinks close enough for a nightcap, a slow morning or the hour between a soak and dinner when getting dressed can wait.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abd4326ec76c56b4485eb30','urban-cowboy','Wifi Access','Wi-Fi when you need it. The forest when you do not.','Complimentary Wi-Fi keeps the practical stuff handled without asking you to stay glued to a screen. Check what you need, then close the laptop and get back to the mountains.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abd42e30b7e2cc95b520591','urban-cowboy','Walk-in Rain Shower','A roomy walk-in rain shower for rinsing off the trail, the creek or a very long day of doing nothing.','Step into a proper walk-in shower with room to wake up slowly or warm back up after the woods. Simple, spacious and exactly where you want it after a hike, a soak or a cold morning.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c9ca5f47abed271d0f7','urban-cowboy','Dogs Welcome','Dog-friendly accommodations across most room types ($50/night pet fee) with access to 200 acres of outdoor trail space.','Don''t leave your best friend behind. Most room types welcome dogs with open arms, custom water bowls, and acres of hiking trails.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c9c09f60a24832b181d','urban-cowboy','Reserved for Guest 21+','The Walden House and Alpine House buildings are zoned exclusively for adult guests aged 21 and older.','To preserve a quiet, peaceful atmosphere for couples and solo travelers, our core soaking suites are strictly reserved for guests 21 and older.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c9ac276b0bf8312e42a','urban-cowboy','Proximity to Belleayre & Hunter Skiing','Located just 15 minutes from Belleayre Mountain Ski Resort and short drives to Hunter Mountain.','Base yourself in luxury for winter sports. Enjoy quick drives to top downhill skiing, snowboarding, cross-country trails, and snow tubing peaks.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c995b7d7b245be4b1f8','urban-cowboy','Direct Hiking Trailhead Access','On-property trailhead located right at Slide Mountain Haus connecting directly to miles of Catskill wilderness trails.','No driving required—step right off the porch onto our network of private and public trails leading into the Big Indian Wilderness and Slide Mountain High Peak.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c99c8b60eb21542460b','urban-cowboy','Dry Stone Patio & Nightly Firepits','Hand-laid bluestone patio with open fire pits, nightly fires, and complimentary s''mores kits.','Gather round the bluestone patio fire pits as evening sets in. Enjoy craft drinks, stargazing, and complimentary gourmet s''mores.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c98b9d3967b917e7967','urban-cowboy','Ralph''s Bar & Vintage Bowling Alley','Historic tavern featuring craft cocktails, pub fare, and a restored 150-year-old two-lane manual bowling alley.','Step into Ralph''s Bar for local beers, fireside tunes, and friendly competition on our vintage two-lane bowling alley across County Route 47.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c9822d8581ea1f1fadd','urban-cowboy','Creekside Swimming Hole & Bluestone Beach','Direct property access to pristine swimming holes and bluestone beaches along Esopus Creek.','Cool off in crystal-clear mountain water or stretch out on sun-warmed bluestone ledges along our private stretch of river.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c9738c0193aae53bbd3','urban-cowboy','40-Foot Suspended Forest Treenet','Custom hand-woven Treenet installation suspended high in the forest canopy above the hiking trail.','Climb up into a massive, hand-woven hammock net suspended 40 feet above the forest floor for a unique bird''s-eye view of the wilderness.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c96f2f76d4903c35a0a','urban-cowboy','Estonian Wood-Burning Iglu Sauna','A cedar wood-burning Estonian Iglu sauna surrounded by hemlock trees, complete with cold river plunge access.','Tucked into the forest along Esopus Creek, our wood-burning Estonian sauna offers deep thermal detoxification paired with refreshing cold mountain air.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c95a900d21d00ba9628','urban-cowboy','Hand-Printed Wallpaper by Printsburgh','Hand-printed block wallpaper crafted by artist Clint Van Gemert of Printsburgh adorns every guest room.','No sterile hotel walls here—every room features bespoke block-printed wallpaper inspired by nature, folklore, and Americana craft.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c94b92ea32dd650409e','urban-cowboy','Private Outdoor Deck & Porch','Private outdoor decks or covered porches attached to Walden, Alpine, Cabin, Chalet, and Lodge suites.','Equipped with rocking chairs, loungers, or soaking tubs, your private deck offers seamless indoor-outdoor wilderness living.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c937ea0623643df2f2f','urban-cowboy','Full Kitchen & Dining Area','Fully equipped kitchens with stoves, ovens, refrigerators, and cookware in The Chalet, Slide Mountain Haus, Opa''s Cabin, and Mountain View Haus.','Enjoy the flexibility of preparing your own meals or hiring a private chef with complete kitchens and spacious dining areas.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c93eb90b8f4d6d90a14','urban-cowboy','River Stone Hearth Fireplace','Grand bluestone and river stone wood-burning fireplaces in Opa''s Cabin, Mountain View Haus, and the Lodge Penthouse.','Built from native Catskill river stone, these massive fireplaces anchor the vaulted living rooms of our standalone chalets.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c92eb90b8f4d6d909f6','urban-cowboy','Enameled Gas Fireplace','Enameled gas fireplaces featured in Alpine Penthouse Suites, The Cabin, and The Chalet.','Enjoy the cozy ambiance of a fireplace with instantaneous warmth, perfect for chilly evenings after a day on the slopes or trail.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c9236cbcba74b8e290c','urban-cowboy','Cast Iron Wood Stove','Authentic wood-burning cast iron stoves featured in Alpine Bathing Suites for genuine fireside warmth.','Curl up next to a crackling wood stove inside your suite. Complete with firewood provided to keep your hearth warm all night.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c915b7d7b245be4b109','urban-cowboy','Radiant Heated Bathroom Floors','Underfloor radiant heating throughout bathrooms in Alpine suites, Penthouse suites, and The Chalet.','Cold Catskill mornings are no match for underfloor radiant heating, keeping your feet cozy from the moment you step out of bed or the shower.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c9161f3d6555e08dce3','urban-cowboy','Copper Clawfoot Soaking Tub','Freestanding copper or cowboy clawfoot tubs situated inside Alpine suites, The Cabin, and the Lodge Penthouse.','Hand-crafted copper clawfoot tubs placed right next to floor-to-ceiling windows, combining rustic warmth with deep-soak luxury.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8c906f99dc64d9a68e84','urban-cowboy','Outdoor Cedar Soaking Tub','Custom Japanese cedar soaking tubs located on private outdoor decks in the Walden House suites and The Chalet.','Crafted from fragrant Japanese cedar and filled with steaming mountain water, these private outdoor tubs allow you to soak under the hemlocks and stars regardless of the weather.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc87c8d5dccb4f1a842fc5','urban-cowboy','Pendleton Robes','Breakfast can wait. Pants definitely can.','The Pendleton robes extend the room beyond the bed. Throw one on after a soak, take your coffee to the deck, or stay wrapped up by the fire while the rest of the world handles itself.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6abc8795d98b325b281ee39c','urban-cowboy','Pendleton Blankets','Pendleton has been weaving wool in the Pacific Northwest for generations, with patterns that have become part of the visual language of the American outdoors','Pendleton has been weaving wool in the Pacific Northwest for generations, with patterns that have become part of the visual language of the American outdoors. Their blankets bring warmth, texture and a familiar bit of Americana into Cowboy''s very particular version of the Catskills. Pendleton still operates woolen mills in Oregon and Washington.',1,'2026-11-24 07:51:22');
CREATE TABLE media_version_fingerprints (
  version_id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
  media_asset_id TEXT NOT NULL,
  sha256 TEXT,
  phash TEXT,
  width INTEGER,
  height INTEGER,
  exif_orientation INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  FOREIGN KEY (tenant_id) REFERENCES tenants (id),
  FOREIGN KEY (media_asset_id) REFERENCES media_assets (id),
  FOREIGN KEY (version_id) REFERENCES media_versions (id),
  FOREIGN KEY (tenant_id, media_asset_id) REFERENCES media_assets (tenant_id, id),
  FOREIGN KEY (tenant_id, version_id) REFERENCES media_version_files (tenant_id, version_id)
);
CREATE TABLE photo_hotspot_mappings (
  id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
  media_asset_id TEXT NOT NULL,
  placement_id TEXT,
  target_table TEXT,
  target_id TEXT,
  amenity_id TEXT NOT NULL,
  source_x REAL NOT NULL CHECK (source_x >= 0 AND source_x <= 1),
  source_y REAL NOT NULL CHECK (source_y >= 0 AND source_y <= 1),
  source_version_id TEXT NOT NULL,
  source_width INTEGER,
  source_height INTEGER,
  exif_orientation INTEGER NOT NULL DEFAULT 1,
  crop_left REAL,
  crop_top REAL,
  crop_width REAL,
  crop_height REAL,
  display_order INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL DEFAULT 'draft' CHECK (status IN ('draft', 'published')),
  review_state TEXT NOT NULL DEFAULT 'none' CHECK (review_state IN ('none', 'pending', 'approved')),
  review_reason TEXT,
  derived_from TEXT,
  duplicate_of TEXT,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at TEXT NOT NULL DEFAULT (datetime('now')),
  FOREIGN KEY (tenant_id) REFERENCES tenants (id),
  FOREIGN KEY (media_asset_id) REFERENCES media_assets (id),
  FOREIGN KEY (tenant_id, media_asset_id) REFERENCES media_assets (tenant_id, id),
  FOREIGN KEY (amenity_id) REFERENCES amenities (id),
  FOREIGN KEY (source_version_id) REFERENCES media_versions (id),
  FOREIGN KEY (derived_from) REFERENCES photo_hotspot_mappings (id)
);
CREATE TABLE photo_hotspot_mapping_revisions (
  id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
  mapping_id TEXT NOT NULL,
  media_asset_id TEXT NOT NULL,
  from_version_id TEXT,
  to_version_id TEXT NOT NULL,
  action TEXT NOT NULL CHECK (
    action IN ('create', 'carry', 'remap', 'review', 'publish', 'rollback')
  ),
  snapshot_json TEXT NOT NULL,
  actor TEXT,
  note TEXT,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  FOREIGN KEY (tenant_id) REFERENCES tenants (id),
  FOREIGN KEY (mapping_id) REFERENCES photo_hotspot_mappings (id),
  FOREIGN KEY (media_asset_id) REFERENCES media_assets (id),
  FOREIGN KEY (from_version_id) REFERENCES media_versions (id),
  FOREIGN KEY (to_version_id) REFERENCES media_versions (id)
);
CREATE TABLE media_placement_flags (
  placement_id TEXT PRIMARY KEY,
