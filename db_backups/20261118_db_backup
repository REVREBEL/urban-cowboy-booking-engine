n":"roomTypes","payload":{"locationId":"6abc9142d98b325b2821ca23","mewsRoomCategoryId":"d0961acc-145f-4ad9-a965-b1f1012e7f00","name":"Slide Mountain Haus 2 Bedroom Suite","slug":"slide-mountain-haus-2-bedroom","sortOrder":16}},{"id":"6abd4a24eea80f91a64d01d1","collection":"roomTypes","payload":{"locationId":"6abc9142d98b325b2821ca23","mewsRoomCategoryId":"d68e4504-7944-43a7-8e12-b1f1012d6350","name":"Slide Mountain Haus","slug":"slide-mountain-haus-full-haus","sortOrder":17}},{"id":"6abd4a25cd450395156515c6","collection":"roomTypes","payload":{"locationId":"6abc9142d98b325b2821ca23","mewsRoomCategoryId":"9f2f57b0-9533-46f0-9d9b-b282017b3741","name":"Mountain View Haus 4 Bedroom Suite","slug":"mountain-view-haus","sortOrder":18}},{"id":"6abd4ef9a4e38259878f2727","collection":"roomTypes","payload":{"locationId":"6abc9142d98b325b2821ca23","mewsRoomCategoryId":"be081636-bd06-4273-bdc3-b10600706caf","name":"Lodge 2 Bedroom Suite","slug":"lodge-two-bedroom-suite","sortOrder":10}},{"id":"6abd502ef996502133a61ac0","collection":"roomTypes","payload":{"locationId":"6abc9142d98b325b2821ca23","mewsRoomCategoryId":"a2230bdd-1770-41b6-8932-b202001df350","name":"Opa''s Cabin 2 Bedroom Suite","slug":"opas-cabin-ee290","sortOrder":20}},{"id":"6abd50f0e0589519e89a7f10","collection":"roomTypes","payload":{"locationId":"6abc9142d98b325b2821ca23","mewsRoomCategoryId":"81ecc428-8c85-405e-8607-b2a500e66429","name":"Mountain View Haus 2 Bedroom Suite","slug":"mountain-view-haus-bbf32","sortOrder":19}}]}',21,'5ede61cd6bd07c003c2b95aad06a1310eee360ff0592347862c0d6f299361748','2026-11-24 08:07:45');
INSERT INTO published_snapshots VALUES('urban-cowboy','','amenities','c0e194bb7c60358f7a40b02c8045fdffb20a9fd12c88f97c4a6f7313b808be0e','{"collection":"amenities","version":"c0e194bb7c60358f7a40b02c8045fdffb20a9fd12c88f97c4a6f7313b808be0e","itemCount":76,"items":[{"id":"6abc8795d98b325b281ee39c","collection":"amenities","payload":{"name":"Pendleton Blankets","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Pendleton Blankets","shortDescription":"Pendleton has been weaving wool in the Pacific Northwest for generations, with patterns that have become part of the visual language of the American outdoors","longDescription":"Pendleton has been weaving wool in the Pacific Northwest for generations, with patterns that have become part of the visual language of the American outdoors. Their blankets bring warmth, texture and a familiar bit of Americana into Cowboy''s very particular version of the Catskills. Pendleton still operates woolen mills in Oregon and Washington.","active":true}},{"id":"6abc87c8d5dccb4f1a842fc5","collection":"amenities","payload":{"name":"Pendleton Robes","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Pendleton Robes","shortDescription":"Breakfast can wait. Pants definitely can.","longDescription":"The Pendleton robes extend the room beyond the bed. Throw one on after a soak, take your coffee to the deck, or stay wrapped up by the fire while the rest of the world handles itself.","active":true}},{"id":"6abc8c906f99dc64d9a68e84","collection":"amenities","payload":{"name":"Outdoor Cedar Soaking Tub","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Outdoor Cedar Soaking Tub","shortDescription":"Custom Japanese cedar soaking tubs located on private outdoor decks in the Walden House suites and The Chalet.","longDescription":"Crafted from fragrant Japanese cedar and filled with steaming mountain water, these private outdoor tubs allow you to soak under the hemlocks and stars regardless of the weather.","active":true}},{"id":"6abc8c915b7d7b245be4b109","collection":"amenities","payload":{"name":"Radiant Heated Bathroom Floors","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Radiant Heated Bathroom Floors","shortDescription":"Underfloor radiant heating throughout bathrooms in Alpine suites, Penthouse suites, and The Chalet.","longDescription":"Cold Catskill mornings are no match for underfloor radiant heating, keeping your feet cozy from the moment you step out of bed or the shower.","active":true}},{"id":"6abc8c9161f3d6555e08dce3","collection":"amenities","payload":{"name":"Copper Clawfoot Soaking Tub","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Copper Clawfoot Soaking Tub","shortDescription":"Freestanding copper or cowboy clawfoot tubs situated inside Alpine suites, The Cabin, and the Lodge Penthouse.","longDescription":"Hand-crafted copper clawfoot tubs placed right next to floor-to-ceiling windows, combining rustic warmth with deep-soak luxury.","active":true}},{"id":"6abc8c9236cbcba74b8e290c","collection":"amenities","payload":{"name":"Cast Iron Wood Stove","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Cast Iron Wood Stove","shortDescription":"Authentic wood-burning cast iron stoves featured in Alpine Bathing Suites for genuine fireside warmth.","longDescription":"Curl up next to a crackling wood stove inside your suite. Complete with firewood provided to keep your hearth warm all night.","active":true}},{"id":"6abc8c92eb90b8f4d6d909f6","collection":"amenities","payload":{"name":"Enameled Gas Fireplace","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Enameled Gas Fireplace","shortDescription":"Enameled gas fireplaces featured in Alpine Penthouse Suites, The Cabin, and The Chalet.","longDescription":"Enjoy the cozy ambiance of a fireplace with instantaneous warmth, perfect for chilly evenings after a day on the slopes or trail.","active":true}},{"id":"6abc8c937ea0623643df2f2f","collection":"amenities","payload":{"name":"Full Kitchen & Dining Area","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Full Kitchen & Dining Area","shortDescription":"Fully equipped kitchens with stoves, ovens, refrigerators, and cookware in The Chalet, Slide Mountain Haus, Opa''s Cabin, and Mountain View Haus.","longDescription":"Enjoy the flexibility of preparing your own meals or hiring a private chef with complete kitchens and spacious dining areas.","active":true}},{"id":"6abc8c93eb90b8f4d6d90a14","collection":"amenities","payload":{"name":"River Stone Hearth Fireplace","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"River Stone Hearth Fireplace","shortDescription":"Grand bluestone and river stone wood-burning fireplaces in Opa''s Cabin, Mountain View Haus, and the Lodge Penthouse.","longDescription":"Built from native Catskill river stone, these massive fireplaces anchor the vaulted living rooms of our standalone chalets.","active":true}},{"id":"6abc8c94b92ea32dd650409e","collection":"amenities","payload":{"name":"Private Outdoor Deck & Porch","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Private Outdoor Deck & Porch","shortDescription":"Private outdoor decks or covered porches attached to Walden, Alpine, Cabin, Chalet, and Lodge suites.","longDescription":"Equipped with rocking chairs, loungers, or soaking tubs, your private deck offers seamless indoor-outdoor wilderness living.","active":true}},{"id":"6abc8c95a900d21d00ba9628","collection":"amenities","payload":{"name":"Hand-Printed Wallpaper by Printsburgh","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Hand-Printed Wallpaper by Printsburgh","shortDescription":"Hand-printed block wallpaper crafted by artist Clint Van Gemert of Printsburgh adorns every guest room.","longDescription":"No sterile hotel walls here—every room features bespoke block-printed wallpaper inspired by nature, folklore, and Americana craft.","active":true}},{"id":"6abc8c96f2f76d4903c35a0a","collection":"amenities","payload":{"name":"Estonian Wood-Burning Iglu Sauna","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Estonian Wood-Burning Iglu Sauna","shortDescription":"A cedar wood-burning Estonian Iglu sauna surrounded by hemlock trees, complete with cold river plunge access.","longDescription":"Tucked into the forest along Esopus Creek, our wood-burning Estonian sauna offers deep thermal detoxification paired with refreshing cold mountain air.","active":true}},{"id":"6abc8c9738c0193aae53bbd3","collection":"amenities","payload":{"name":"40-Foot Suspended Forest Treenet","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"40-Foot Suspended Forest Treenet","shortDescription":"Custom hand-woven Treenet installation suspended high in the forest canopy above the hiking trail.","longDescription":"Climb up into a massive, hand-woven hammock net suspended 40 feet above the forest floor for a unique bird''s-eye view of the wilderness.","active":true}},{"id":"6abc8c9822d8581ea1f1fadd","collection":"amenities","payload":{"name":"Creekside Swimming Hole & Bluestone Beach","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Creekside Swimming Hole & Bluestone Beach","shortDescription":"Direct property access to pristine swimming holes and bluestone beaches along Esopus Creek.","longDescription":"Cool off in crystal-clear mountain water or stretch out on sun-warmed bluestone ledges along our private stretch of river.","active":true}},{"id":"6abc8c98b9d3967b917e7967","collection":"amenities","payload":{"name":"Ralph''s Bar & Vintage Bowling Alley","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Ralph''s Bar & Vintage Bowling Alley","shortDescription":"Historic tavern featuring craft cocktails, pub fare, and a restored 150-year-old two-lane manual bowling alley.","longDescription":"Step into Ralph''s Bar for local beers, fireside tunes, and friendly competition on our vintage two-lane bowling alley across County Route 47.","active":true}},{"id":"6abc8c995b7d7b245be4b1f8","collection":"amenities","payload":{"name":"Direct Hiking Trailhead Access","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Direct Hiking Trailhead Access","shortDescription":"On-property trailhead located right at Slide Mountain Haus connecting directly to miles of Catskill wilderness trails.","longDescription":"No driving required—step right off the porch onto our network of private and public trails leading into the Big Indian Wilderness and Slide Mountain High Peak.","active":true}},{"id":"6abc8c99c8b60eb21542460b","collection":"amenities","payload":{"name":"Dry Stone Patio & Nightly Firepits","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Dry Stone Patio & Nightly Firepits","shortDescription":"Hand-laid bluestone patio with open fire pits, nightly fires, and complimentary s''mores kits.","longDescription":"Gather round the bluestone patio fire pits as evening sets in. Enjoy craft drinks, stargazing, and complimentary gourmet s''mores.","active":true}},{"id":"6abc8c9ac276b0bf8312e42a","collection":"amenities","payload":{"name":"Proximity to Belleayre & Hunter Skiing","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Proximity to Belleayre & Hunter Skiing","shortDescription":"Located just 15 minutes from Belleayre Mountain Ski Resort and short drives to Hunter Mountain.","longDescription":"Base yourself in luxury for winter sports. Enjoy quick drives to top downhill skiing, snowboarding, cross-country trails, and snow tubing peaks.","active":true}},{"id":"6abc8c9c09f60a24832b181d","collection":"amenities","payload":{"name":"Reserved for Guest 21+","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Reserved for Guest 21+","shortDescription":"The Walden House and Alpine House buildings are zoned exclusively for adult guests aged 21 and older.","longDescription":"To preserve a quiet, peaceful atmosphere for couples and solo travelers, our core soaking suites are strictly reserved for guests 21 and older.","active":true}},{"id":"6abc8c9ca5f47abed271d0f7","collection":"amenities","payload":{"name":"Dogs Welcome","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Dogs Welcome","shortDescription":"Dog-friendly accommodations across most room types ($50/night pet fee) with access to 200 acres of outdoor trail space.","longDescription":"Don''t leave your best friend behind. Most room types welcome dogs with open arms, custom water bowls, and acres of hiking trails.","active":true}},{"id":"6abd42e30b7e2cc95b520591","collection":"amenities","payload":{"name":"Walk-in Rain Shower","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Walk-in Rain Shower","shortDescription":"A roomy walk-in rain shower for rinsing off the trail, the creek or a very long day of doing nothing.","longDescription":"Step into a proper walk-in shower with room to wake up slowly or warm back up after the woods. Simple, spacious and exactly where you want it after a hike, a soak or a cold morning.","active":true}},{"id":"6abd4326ec76c56b4485eb30","collection":"amenities","payload":{"name":"Wifi Access","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Wifi Access","shortDescription":"Wi-Fi when you need it. The forest when you do not.","longDescription":"Complimentary Wi-Fi keeps the practical stuff handled without asking you to stay glued to a screen. Check what you need, then close the laptop and get back to the mountains.","active":true}},{"id":"6ac3e0882889661b038ec787","collection":"amenities","payload":{"name":"Minibar","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Minibar","shortDescription":"Good things within arm''s reach when leaving the room feels wildly unnecessary.","longDescription":"The in-room minibar keeps snacks and drinks close enough for a nightcap, a slow morning or the hour between a soak and dinner when getting dressed can wait.","active":true}},{"id":"6acb3c6dd423991cbf6a43ec","collection":"amenities","payload":{"name":"Family Friendly","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Family Friendly","shortDescription":"Room to bring the little campers along.","longDescription":"These accommodations welcome families, with layouts that make it easier to stay together without giving up the breathing room that brought you to the mountains in the first place.","active":true}},{"id":"6acfa9526e22d8f55d602032","collection":"amenities","payload":{"name":"Double Beds","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Double Beds","shortDescription":"Two proper beds for friends, family or anyone who sleeps better with a little territory of their own.","longDescription":"Two separate beds keep the room flexible for friends and families, with enough personal space to spread-out. Outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control. What it means for your stay: A genuinely good bed waiting after the sauna, the trail, one more drink at Ralph''s, or absolutely nothing at all.","active":true}},{"id":"6acfa9a401e6d06e270bdcdf","collection":"amenities","payload":{"name":"Alpine Bed Southwestern Print","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Alpine King Bed","shortDescription":"A king bed dressed in the bold Southwestern pattern that gives Alpine its unmistakable Cowboy character.","longDescription":"The bed is the visual center of the room: a Wright king mattress layered with Pendleton warmth and a Southwestern-patterned headboard treatment that brings a little graphic swagger to Alpine without getting in the way of a very good night''s sleep.","active":true}},{"id":"6acfa9e57c6104a6aa94c51e","collection":"amenities","payload":{"name":"Cabin Beds","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Cabin King Bed + Bunk","shortDescription":"A king bed with an extra bunk nook, outfitted with Wright mattresses, built for a little more flexibility inside your private cabin","longDescription":"The Cabin keeps the sleeping setup relaxed: a proper king bed anchors the room, while the built-in bunk or lounging nook gives you another place to stretch outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control.","active":true}},{"id":"6acfaa2ef94e6428a3ad2661","collection":"amenities","payload":{"name":"Lodge Penthouse Living Room","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Lodge Penthouse Living Room","shortDescription":"A substantial private living room at the top of the Lodge, made for lingering between whatever comes next.","longDescription":"The Penthouse gives you more than a bedroom. Its private living room brings together vaulted windows, comfortable seating, a wet bar and room to settle in, with the social heart of Cowboy just downstairs.","active":true}},{"id":"6acfadbc62dec1d97b63129c","collection":"amenities","payload":{"name":"Architectural Diamond Window","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Architectural Diamond Window","shortDescription":"A diamond-shaped window that turns morning light and mountain weather into part of the room.","longDescription":"One of Cowboy''s unique architectural details: a diamond-shaped window framing treetops, sky and shifting Catskills light. It gives the room a view with a little more character than a standard rectangle.","active":true}},{"id":"6acfadbc62dec1d97b63129e","collection":"amenities","payload":{"name":"Built-In Alcove","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Built-In Alcove","shortDescription":"A tucked-away nook made for reading, lounging and disappearing for a while.","longDescription":"A small room within the room. Settle into the alcove with a book, a drink or absolutely no plan, and let the rest of the suite carry on without you.","active":true}},{"id":"6acfadbc62dec1d97b6312a0","collection":"amenities","payload":{"name":"Alpine Bear Pattern Bed","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Alpine Bear Pattern Bed","shortDescription":"A king bed with a little wilderness worked right into the pattern.","longDescription":"The bear-patterned Alpine bed brings a playful dose of mountain character to the room while keeping the important part simple: a generous place to sleep. Outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control.","active":true}},{"id":"6acfadbc62dec1d97b6312a4","collection":"amenities","payload":{"name":"Bathroom Amenities","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Bathroom Amenities","shortDescription":"Thoughtful bath essentials for the soak, the shower and whatever comes after.","longDescription":"Everything you need to settle into the bathing ritual, from shower essentials to the small comforts waiting by the sink. Practical, considered and designed to keep the bathroom feeling like part of the stay, not a checklist.","active":true}},{"id":"6acfadbc62dec1d97b6312a6","collection":"amenities","payload":{"name":"Two Beds with Headboards","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Two Beds with Headboards","shortDescription":"Two separate beds, each with a proper headboard and room to land.","longDescription":"A flexible setup for friends or family, with two distinct beds that make sharing the room easy without asking anyone to surrender their own corner of it.","active":true}},{"id":"6acfadbc62dec1d97b6312a8","collection":"amenities","payload":{"name":"Two Beds without Headboards","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Two Beds without Headboards","shortDescription":"Two straightforward beds for a simple, flexible sleeping setup.","longDescription":"No extra ceremony here. Two separate beds give friends or family an easy place to sleep while leaving the rest of the room open for the parts of the trip that happen while everyone is awake.","active":true}},{"id":"6acfadbc62dec1d97b6312aa","collection":"amenities","payload":{"name":"Lodge Penthouse King Bed","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Lodge Penthouse King Bed","shortDescription":"A king bed anchored by the Penthouse''s hand-crafted black-willow headboard.","longDescription":"At the top of the Lodge, the king bed gets a little theater from its hand-crafted black-willow headboard. It is part bed, part woodland sculpture, and exactly the sort of detail that makes the Penthouse feel unlike anywhere else in the building.","active":true}},{"id":"6acfadbc62dec1d97b6312ac","collection":"amenities","payload":{"name":"Single Bed with Headboard","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Single Bed with Headboard","shortDescription":"One bed, one proper headboard outfitted with a Wright mattress and one very good excuse to sleep late.","longDescription":"A simple single-bed setup with a defined headboard and enough visual weight to make the bed feel like part of the room rather than something dropped into it. Cowboy rooms are outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control. What it means for your stay: A genuinely good bed waiting after the sauna, the trail, one more drink at Ralph''s, or absolutely nothing at all.","active":true}},{"id":"6acfadbc62dec1d97b6312ae","collection":"amenities","payload":{"name":"Single Bed","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Single Bed","shortDescription":"One straightforward bed for a room that keeps things simple.","longDescription":"A clean, uncomplicated sleeping setup for guests who need one bed and would rather let the rest of the Catskills provide the decoration. Cowboy rooms are outfitted with Wright mattresses, designed around the things that actually make a bed good: balanced support, pressure relief, responsiveness and temperature control. What it means for your stay: A genuinely good bed waiting after the sauna, the trail, one more drink at Ralph''s, or absolutely nothing at all.","active":true}},{"id":"6acfadbc62dec1d97b6312b2","collection":"amenities","payload":{"name":"Cabin Bedroom","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Cabin Bedroom","shortDescription":"A king bedroom tucked inside your own standalone Catskills hideaway.","longDescription":"The Cabin bedroom keeps the mood warm and private, with the bed at the center and the rest of the standalone space just beyond it. Close the door, settle in and let the woods handle the view.","active":true}},{"id":"6acfadbc62dec1d97b6312b4","collection":"amenities","payload":{"name":"Cabin Sitting Area","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Cabin Sitting Area","shortDescription":"A private place to stretch out somewhere that is not the bed.","longDescription":"The Cabin''s sitting area gives the room a second rhythm: read by the fire, pour a drink, or do absolutely nothing from a proper seat before wandering back to the tub, porch or bed.","active":true}},{"id":"6acfadbc62dec1d97b6312b6","collection":"amenities","payload":{"name":"Chalet Full Kitchen","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Chalet Full Kitchen","shortDescription":"A full kitchen for breakfast at noon, dinner at midnight or whatever happens in between.","longDescription":"The Chalet gives you a proper kitchen of your own, so the stay can feel more like borrowing a mountain house than checking into a hotel. Cook something ambitious, heat up something easy or leave it untouched and go to dinner.","active":true}},{"id":"6acfadbc62dec1d97b6312b8","collection":"amenities","payload":{"name":"Chalet Living Room","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Chalet Living Room","shortDescription":"Room to spread out beneath the Chalet''s wood-paneled cathedral ceilings.","longDescription":"Two lounging areas, big windows and a fireplace give the Chalet real living space beyond the bedroom. It is made for long mornings, late drinks and the kind of afternoon that accidentally becomes evening.","active":true}},{"id":"6acfadbc62dec1d97b6312bc","collection":"amenities","payload":{"name":"Chalet Kitchen with Breakfast Bar","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Kitchen with Breakfast Bar","shortDescription":"A full kitchen with a casual perch for coffee, snacks and plans that may never happen.","longDescription":"Cook when you want to, then pull up to the breakfast bar for the informal part. It is useful space that makes a longer stay feel less like hotel living and more like having your own place Upstate.","active":true}},{"id":"6acfadbc62dec1d97b6312c0","collection":"amenities","payload":{"name":"Marshall Speaker","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Marshall Speaker","shortDescription":"A Marshall speaker for putting a soundtrack to the room.","longDescription":"Queue up the road-trip playlist, something slow for the bath or the record you forgot existed. The speaker is there when the room needs music and easy to ignore when the forest sounds better.","active":true}},{"id":"6acfadbc62dec1d97b6312c2","collection":"amenities","payload":{"name":"Opa''s Cabin Living Room","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Opa''s Cabin Living Room","shortDescription":"A vaulted living room gathered around a big river-stone hearth.","longDescription":"Opa''s shared heart is downstairs: exposed wood beams overhead, the river-stone fireplace in front of you and enough room for the whole group to settle in without sitting on top of one another.","active":true}},{"id":"6acfadbc62dec1d97b6312c4","collection":"amenities","payload":{"name":"Opa''s Full Kitchen","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Opa''s Full Kitchen","shortDescription":"A proper kitchen and dining setup for doing the whole Upstate-house thing yourselves.","longDescription":"Opa''s gives the group a full kitchen and dining area, so breakfast, dinner and the snacks between them can happen on your own clock. Cook together, assign one brave volunteer or ignore the kitchen entirely.","active":true}},{"id":"6acfadbc62dec1d97b6312c6","collection":"amenities","payload":{"name":"Patio Seating Round Chairs","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Outdoor Patio or Balcony with Chairs","shortDescription":"A small outdoor setup for coffee, nightcaps and watching the woods do their thing.","longDescription":"A simple outdoor perch for fresh air without leaving your room behind. Take breakfast outside, linger after a soak or sit still long enough to notice how quiet the mountain gets.","active":true}},{"id":"6acfadbc62dec1d97b6312c8","collection":"amenities","payload":{"name":"Patio Seating Square Chairs","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Outdoor Patio or Balcony with Chairs","shortDescription":"A simple outdoor perch for fresh air without leaving your room behind.","longDescription":"A simple outdoor perch for fresh air without leaving your room behind. Take breakfast outside, linger after a soak or sit still long enough to notice how quiet the mountain gets.","active":true}},{"id":"6acfadbc62dec1d97b6312cc","collection":"amenities","payload":{"name":"Lodge Private Wet Bar","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Private Wet Bar","shortDescription":"Your own wet bar for keeping the evening close to home.","longDescription":"A private wet bar gives the living space a little more independence. Pour a drink, make something cold and stay upstairs when the room is exactly where you want to be.","active":true}},{"id":"6acfadbc62dec1d97b6312ce","collection":"amenities","payload":{"name":"Separate Living Room","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Separate Living Room","shortDescription":"A bedroom that does not have to do all the work.","longDescription":"A separate living room gives the stay another place to happen. Spread out, gather with your people or close the bedroom door and keep the conversation going somewhere else.","active":true}},{"id":"6acfadbc62dec1d97b6312d0","collection":"amenities","payload":{"name":"Sitting Area","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Sitting Area","shortDescription":"A little more room to sit somewhere that is not the bed.","longDescription":"A dedicated sitting area gives you a place for coffee, reading, conversation or staring out the window while pretending that counts as an activity. Around here, it does.","active":true}},{"id":"6acfadbc62dec1d97b6312d2","collection":"amenities","payload":{"name":"Slide Mountain Downstairs Living Room","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Slide Mountain Downstairs Living Room","shortDescription":"A proper living room for game nights, slow mornings and your first-floor Slide Mountain home base.","longDescription":"The downstairs living room gives the two-bedroom Slide Mountain setup a shared center of gravity, with room to spread out before the trail, after Ralph''s or during the highly underrated middle part of the day.","active":true}},{"id":"6acfadbc62dec1d97b6312d4","collection":"amenities","payload":{"name":"Slide Mountain Haus Upstairs Living Room","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Slide Mountain Haus Living Room","shortDescription":"Shared living space for the crew when you take over Slide Mountain Haus.","longDescription":"When the whole Haus is yours, the living room becomes the place everyone eventually lands. Gather before the trail, recover after it or let the group scatter across the house and find its way back here.","active":true}},{"id":"6acfadbc62dec1d97b6312d6","collection":"amenities","payload":{"name":"Mountain Views","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Mountain Views","shortDescription":"Big Catskills views with very little effort required on your part.","longDescription":"Windows, balconies and porches frame the mountains differently across the property. The common thread is simple: look up, slow down and let the valley, peaks and weather keep changing the picture.","active":true}},{"id":"6acfadbc62dec1d97b6312d8","collection":"amenities","payload":{"name":"Walden Private Balcony","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Walden Private Balcony","shortDescription":"A private Walden deck tucked into the trees on the creekside side of the property.","longDescription":"Step outside your Walden room and the forest gets immediately closer. The private deck gives you a quiet place for coffee, a nightcap or the long stretch between plans when the creek and trees are enough.","active":true}},{"id":"6acfadbc62dec1d97b6312da","collection":"amenities","payload":{"name":"Walden Den Alcove","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Walden Den Alcove","shortDescription":"A built-in chaise alcove for reading, lounging and watching the woods from inside.","longDescription":"The Den''s built-in alcove gives Walden an extra place to disappear between soaks. Stretch out with a book, watch the light change through the trees or stay exactly where you are until dinner becomes somebody else''s problem.","active":true}},{"id":"6acfadbc62dec1d97b6312dc","collection":"amenities","payload":{"name":"Walden Bathing Suite Den","imageName":null,"imagePath":null,"sortOrder":0,"shortName":"Walden Bathing Suite Den","shortDescription":"Extra indoor lounging space paired with Walden''s outdoor bathing ritual.","longDescription":"The alcove gives the Walden Forest Bathing Suite more room to live in, not just sleep in. Settle into the lounge before stepping onto the private deck and into the cedar tub under the trees.","active":true}},{"id":"6ad6550182f8316ecc078396","collection":"amen