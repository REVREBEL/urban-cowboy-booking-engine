CREATE TABLE upgrades (
  id TEXT PRIMARY KEY,
  tenant_id TEXT NOT NULL,
  location_id TEXT,
  name TEXT NOT NULL,
  description TEXT,
  priority INTEGER NOT NULL DEFAULT 0,
  audience_rule TEXT,
  room_rule TEXT,
  media_asset_id TEXT,
  status TEXT NOT NULL DEFAULT 'draft',
