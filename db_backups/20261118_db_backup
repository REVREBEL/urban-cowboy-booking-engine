INSERT INTO amenity_editorial VALUES('6ad6d75d5e807d490aea8749','urban-cowboy','Alpine Bathing Suite Den','The Den gives the Forest Bathing Suite more room to live in, not just sleep in.','The Den gives the Forest Bathing Suite more room to live in, not just sleep in. Settle into the lounge before stepping onto your private copper soaking tub view a view the the tree line.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6ad6b3390141c26168dfc836','urban-cowboy','Hand-Printed Wallpaper by Printsburgh','Hand-printed block wallpaper crafted by artist Clint Van Gemert of Printsburgh adorns every guest room.','No sterile hotel walls here—every room features bespoke block-printed wallpaper inspired by nature, folklore, and Americana craft.',1,'2026-11-24 07:51:22');
INSERT INTO amenity_editorial VALUES('6ad6a828965ee41a33acf7dd','urban-cowboy','Pendleton Blankets','Pendleton has been weaving wool in the Pacific Northwest for generations, with patterns that have become part of the visual language of the American outdoors','Pendleton has been weaving wool in the Pacific Northwest for generations, with patterns that have become part of the visual language of the American outdoors. Their blankets bring warmth, texture and a familiar bit of Americana into Cowboy''s very particular version of the Catskills. Pendleton still operates woolen mills in Oregon and Washington.',1,'2026-11-24 07:51:22');
