  updated_at TEXT NOT NULL DEFAULT (datetime('now')),
  FOREIGN KEY (placement_id) REFERENCES media_placements (id),
  FOREIGN KEY (tenant_id, placement_id) REFERENCES media_placements (tenant_id, id)
